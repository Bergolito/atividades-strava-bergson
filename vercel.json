{
    "builds": [
      {
        "src": "painel_strava_app_main.py",
        "use": "vercel-python",
        "config": {
          "maxLambdaSize": "15mb",
          "runtime": "python3.10"
        }
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "painel_strava_app_main.py"
      }
    ]
  }